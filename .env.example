# Kurukshetra Honeypot — Production / GCP VM Configuration
# Copy to .env and fill values before: docker-compose up --build

HONEYPOT_HOST=0.0.0.0
HONEYPOT_TARGET_IP=YOUR_GCP_VM_EXTERNAL_IP
SSH_PORT=2222
WEB_PORT=8080

# Live Render backend (already deployed)
BACKEND_URL=https://kurukshetra-backend.onrender.com
BACKEND_EVENT_ENDPOINT=/api/events

HONEYPOT_HOSTNAME=corp-app-prod01
WEB_TITLE=Internal Corporate Enterprise Portal
SSH_AUTH_MODE=accept_all

# Optional: Groq AI for honeypot threat advisor
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: set after running provision_clone.py
# CLONE_PROFILE_PATH=clone_profiles/acme-corp.json
