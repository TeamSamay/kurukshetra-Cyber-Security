# ===================================================================
# Honeypot / Cyber Deception Layer Configuration
# ===================================================================

# Server Network Binding
HONEYPOT_HOST=0.0.0.0
HONEYPOT_TARGET_IP=192.168.1.20   # Reported Target IP in events (or auto-detected)

# Service Ports
SSH_PORT=2222
WEB_PORT=8080
API_PORT=8080                    # Mounted alongside web server or on dedicated port

# Backend Event Dispatcher (Member 3 API)
# Do not hardcode IPs. Set the actual backend IP during LAN integration.
BACKEND_URL=http://localhost:8000
BACKEND_EVENT_ENDPOINT=/api/events
BACKEND_RETRY_INTERVAL_SEC=5
BACKEND_MAX_QUEUE_SIZE=5000
BACKEND_TIMEOUT_SEC=3.0

# Local Storage
LOG_DIR=logs
EVENTS_JSONL_FILE=logs/events.jsonl

# Deception Persona & Fake Host Info
HONEYPOT_HOSTNAME=corp-app-prod01
HONEYPOT_OS_VERSION=Linux 5.15.0-88-generic #98-Ubuntu SMP Mon Oct 2 15:18:56 UTC 2023 x86_64
HONEYPOT_BANNER=Ubuntu 22.04.3 LTS (GNU/Linux 5.15.0-88-generic x86_64)

# SSH Deception Strategy
# 'accept_all': Allow any user/password to access the fake shell trap
# 'credential_list': Only accept passwords from common wordlists (e.g. root/root, admin/admin123, dev/password)
SSH_AUTH_MODE=accept_all
SSH_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.4
SSH_SESSION_TIMEOUT_SEC=300

# Web & API Deception Settings
WEB_TITLE=Internal Corporate Enterprise Portal
FAKE_JWT_SECRET=c3VwZXItc2VjcmV0LWtleS1kb25vdC1zaGFyZQ==
